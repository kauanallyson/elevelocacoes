---
import "../styles/global.css";
import { Font } from "astro:assets";
import SEO from "../components/seo/SEO.astro";
import Pixel from "../components/analytics/Pixel.astro";
import PixelEvents from "../components/analytics/PixelEvents.astro";
import CookieConsent from "../components/cookies/CookieConsent.astro";

interface Props {
  titulo?: string;
  descricao?: string;
}

const {
  titulo = "Eleve Locações",
  descricao = "Locação de andaimes, betoneiras, martelos demolidores, geradores e outros equipamentos para construção civil em Sobral-CE.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO titulo={titulo} descricao={descricao} />

    <Font cssVariable="--font-big-shoulders" />
    <Font cssVariable="--font-plex-sans" />
    <Font cssVariable="--font-plex-mono" />

    <Pixel />
  </head>
  <body class="font-sans scroll-smooth">
    <slot />
    <PixelEvents />
    <CookieConsent />
  </body>
</html>
