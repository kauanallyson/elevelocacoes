---
import "../styles/global.css";
import { Font } from "astro:assets";
import SEO from "../components/SEO.astro";
import Pixel from "../components/Pixel.astro";
import PixelEvents from "../components/PixelEvents.astro";

const titulo = "Eleve Locações";
const descricao =
  "Locação de andaimes, betoneiras, martelos demolidores, geradores e outros equipamentos para construção civil em Sobral-CE.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO titulo={titulo} descricao={descricao} />

    <Font cssVariable="--font-big-shoulders" preload />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" />

    <Pixel />
  </head>
  <body class="font-sans">
    <slot />
    <PixelEvents />
  </body>
</html>
