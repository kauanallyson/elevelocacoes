---
const passos = [
  {
    numero: "01",
    titulo: "Escolha o equipamento",
    texto: "Busque no catálogo e veja o preço certo — por período ou por peça/dia.",
  },
  {
    numero: "02",
    titulo: "Chame no WhatsApp",
    texto: "Confirme prazo e disponibilidade direto com o atendente, sem formulário.",
  },
  {
    numero: "03",
    titulo: "Retire ou receba na obra",
    texto: "Retirada na loja em Sobral ou entrega — frete conforme o caso, combinado no atendimento.",
  },
];
---

<section id="como-funciona" class="bg-graphite-050 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-dark">
      Como funciona
    </p>
    <h2 class="mt-3 max-w-xl font-display text-3xl leading-tight text-graphite-900 sm:text-4xl">
      Do catálogo até a obra, em três passos
    </h2>

    <ol class="mt-10 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {
        passos.map((passo) => (
          <li class="relative border-l-2 border-accent pl-5 sm:border-l-0 sm:border-t-2 sm:pl-0 sm:pt-5">
            <span class="font-mono text-sm font-semibold text-accent-dark">
              {passo.numero}
            </span>
            <h3 class="mt-2 font-display text-xl text-graphite-900">
              {passo.titulo}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-graphite-700">
              {passo.texto}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
