---
import { Image } from "astro:assets";
import logoHorizontal from "../assets/logo3x1-no-bg.png";
import { linkWhatsApp, MENSAGEM_GERAL } from "../lib/whatsapp";

const credibilidade = [
  "40+ equipamentos",
  "Entrega em Sobral",
  "Atendimento direto no WhatsApp",
];
---

<section class="relative overflow-hidden bg-graphite-900 pt-16">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.2fr_1fr] lg:items-stretch lg:py-20"
  >
    <div>
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.25em] text-accent"
      >
        Sobral-CE locação de equipamentos
      </p>
      <h1
        class="mt-5 font-display text-[2.5rem] leading-[1.05] tracking-tight text-white sm:text-6xl"
      >
        Equipamentos para sua obra, prontos para{" "}
        <span class="text-accent">entrega em Sobral.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed sm:text-lg">
        Andaimes, betoneiras, martelos, geradores e mais de 40 equipamentos para
        construção civil. Escolha, confirme o preço e chame no WhatsApp, sem
        burocracia.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/catalogo"
          class="inline-flex items-center rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-graphite-900 transition-colors hover:bg-accent-dark"
        >
          Ver catálogo
        </a>
        <a
          href={linkWhatsApp(MENSAGEM_GERAL)}
          target="_blank"
          rel="noopener noreferrer"
          data-pixel="whatsapp"
          class="inline-flex items-center rounded-sm border border-graphite-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-accent hover:text-accent"
        >
          Falar no WhatsApp
        </a>
      </div>
    </div>

    <div
      class="flex flex-col justify-between border-t border-graphite-700 pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0"
    >
      <div
        class="hidden flex-1 items-center justify-center py-6 sm:flex lg:py-8"
      >
        <Image
          src={logoHorizontal}
          alt="Eleve Locações de Equipamentos"
          class="w-full max-w-md rounded-sm lg:max-w-lg"
          loading="eager"
        />
      </div>

      <dl class="grid gap-5">
        {
          credibilidade.map((item) => (
            <div class="flex items-baseline gap-3">
              <span class="h-2 w-2 shrink-0 bg-accent" aria-hidden="true" />
              <dd class="text-sm font-medium text-graphite-100 sm:text-base">
                {item}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
