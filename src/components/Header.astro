---
import { linkWhatsApp, MENSAGEM_GERAL } from "../lib/whatsapp";
import { Image } from "astro:assets";
import logoQuadrada from "../assets/logo1x1.png";
import logoHorizontal from "../assets/logo3x1-no-bg-gray.png";
import WhatsAppIcon from "./icons/WhatsAppIcon.astro";

const links = [
  { href: "/", label: "Início" },
  { href: "/catalogo", label: "Catálogo" },
  { href: "/#contato", label: "Contato" },
];
---

<header
  class="sticky inset-x-0 top-0 z-40 border-b border-graphite-100 bg-white/95 backdrop-blur"
>
  <div
    class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
  >
    <a href="/" class="shrink-0">
      <Image
        src={logoHorizontal}
        alt="Eleve Locações de Equipamentos"
        class="h-12 w-auto sm:hidden"
        loading="eager"
      />
      <Image
        src={logoQuadrada}
        alt="Eleve Locações de Equipamentos"
        class="hidden h-12 w-12 sm:block"
        loading="eager"
      />
    </a>

    <nav
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 md:flex"
      aria-label="Navegação principal"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-graphite-700 transition-colors hover:text-accent-dark"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href={linkWhatsApp(MENSAGEM_GERAL)}
      target="_blank"
      rel="noopener noreferrer"
      data-pixel="whatsapp"
      class="inline-flex shrink-0 items-center gap-2 rounded-sm bg-accent px-4 py-2.5 text-sm font-semibold text-graphite-900 transition-colors hover:bg-accent-dark"
    >
      <WhatsAppIcon />
      <span class="hidden sm:inline">Falar no WhatsApp</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  </div>
</header>
