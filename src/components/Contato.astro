---
const ENDERECO =
  "Rua Dr. Ronaldo Ponte Dias, 1279, Bairro Antônio Carlos Belchior, Sobral-CE";
const TELEFONE = [{ numero: "(88) 99998-3050", tel: "+5588999983050" }];
const INSTAGRAM = "https://www.instagram.com/elevelocacoes/";

type ContatoItem =
  | { label: string; type: "text"; value: string }
  | { label: string; type: "phones"; value: typeof TELEFONE }
  | { label: string; type: "link"; value: { href: string; text: string } };

const contatoItems: ContatoItem[] = [
  { label: "Endereço", type: "text", value: ENDERECO },
  { label: "Whatsapp", type: "phones", value: TELEFONE },
  {
    label: "Instagram",
    type: "link",
    value: { href: INSTAGRAM, text: "@elevelocacoes" },
  },
  {
    label: "E-mail",
    type: "link",
    value: {
      href: "mailto:elevelocacoes@gmail.com",
      text: "elevelocacoes@gmail.com",
    },
  },
  {
    label: "Horário",
    type: "text",
    value: "Segunda a sexta, 7h30 às 12h e 13h30 às 17h",
  },
];
---

<section id="contato" class="bg-graphite-900 pt-16 pb-10 sm:pt-24 sm:pb-12">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2">
    <div>
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent"
      >
        Contato
      </p>
      <h2
        class="mt-3 font-display text-3xl leading-tight text-white sm:text-4xl"
      >
        Fale com um de nossos atendentes!
      </h2>

      <dl class="mt-8 space-y-6 text-sm">
        {
          contatoItems.map((item) => (
            <div>
              <dt class="font-mono uppercase tracking-wide text-graphite-300">
                {item.label}
              </dt>
              {item.type === "text" && (
                <dd class="mt-1 text-graphite-100">{item.value}</dd>
              )}
              {item.type === "link" && (
                <dd class="mt-1">
                  <a
                    href={item.value.href}
                    class="text-graphite-100 underline decoration-graphite-700 underline-offset-4 transition-colors hover:text-accent"
                  >
                    {item.value.text}
                  </a>
                </dd>
              )}
              {item.type === "phones" && (
                <dd class="mt-1 flex flex-col gap-1">
                  {item.value.map((telefone) => (
                    <a
                      href={`tel:${telefone.tel}`}
                      class="text-graphite-100 underline decoration-graphite-700 underline-offset-4 transition-colors hover:text-accent"
                    >
                      {telefone.numero}
                    </a>
                  ))}
                </dd>
              )}
            </div>
          ))
        }
      </dl>
    </div>

    <div
      class="min-h-80 overflow-hidden rounded-md border border-graphite-700 lg:min-h-full"
    >
      <iframe
        title="Localização da Eleve Locações no Google Maps"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4909.590913257385!2d-40.32587682414844!3d-3.680347142931439!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x7eac745db806fab%3A0x4d7a2865a9fc0836!2zRWxldmUgTG9jYcOnw7VlcyBlIFNlcnZpw6dvcyB8IFNvYnJhbA!5e1!3m2!1spt-BR!2sbr!4v1785884243830!5m2!1spt-BR!2sbr"
        width="600"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </div>
</section>
