---
import fs from "node:fs";
import path from "node:path";
import { CATEGORIAS, EQUIPAMENTOS } from "../../data/equipamentos";
import { linkWhatsApp, MENSAGEM_GERAL } from "../../lib/whatsapp";
import Button from "../ui/Button.astro";
import Chip from "../ui/Chip.astro";
import EquipamentoList from "./EquipamentoList.astro";

const equipamentosExibidos = EQUIPAMENTOS.map((equipamento) => ({
  ...equipamento,
  temFoto: fs.existsSync(
    path.resolve("src/assets/produtos", `${equipamento.slug}.webp`),
  ),
}));
---

<section id="catalogo" class="bg-white py-4 sm:py-8">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h1 class="font-mono font-medium uppercase text-accent-dark text-4xl">
        Catálogo
      </h1>
    </div>

    <div id="catalogo-filtro">
      <div
        class="top-16 z-30 -mx-4 flex flex-col gap-4 border-b border-graphite-100 bg-white/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6"
      >
        <div class="relative max-w-md">
          <label for="busca-equipamento" class="sr-only">
            Buscar equipamento pelo nome
          </label>
          <input
            id="busca-equipamento"
            type="search"
            placeholder="Buscar equipamento (ex: betoneira, escora, martelo...)"
            class="w-full rounded-sm border border-graphite-300 bg-white px-4 py-2.5 text-sm text-graphite-900 placeholder:text-graphite-700/60 focus-visible:border-accent-dark"
            autocomplete="off"
          />
        </div>

        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-label="Filtrar por categoria"
        >
          <Chip categoria="todos" active> Todos </Chip>
          {
            CATEGORIAS.map((categoria) => (
              <Chip categoria={categoria.id}>{categoria.label}</Chip>
            ))
          }
        </div>
      </div>

      <EquipamentoList
        id="catalogo-grid"
        class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-4"
        equipamentos={equipamentosExibidos}
      />

      <div id="catalogo-vazio" class="hidden py-16 text-center">
        <p class="font-display text-xl text-graphite-900">
          Nenhum equipamento encontrado
        </p>
        <p class="mt-2 text-graphite-700">
          Não achou o que precisa no catálogo? Chame no WhatsApp a gente pode
          ter o equipamento fora da lista.
        </p>
        <Button
          href={linkWhatsApp(MENSAGEM_GERAL)}
          target="_blank"
          rel="noopener noreferrer"
          data-pixel="whatsapp"
          class="mt-5"
        >
          Falar no WhatsApp
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  function normalizar(texto: string) {
    return texto.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  }

  const raiz = document.getElementById("catalogo-filtro");
  if (raiz) {
    const inputBusca =
      raiz.querySelector<HTMLInputElement>("#busca-equipamento");
    const chips = raiz.querySelectorAll<HTMLButtonElement>(".chip-categoria");
    const cards = Array.from(
      raiz.querySelectorAll<HTMLElement>("#catalogo-grid [data-card]"),
    );
    const grid = raiz.querySelector<HTMLElement>("#catalogo-grid");
    const vazio = raiz.querySelector<HTMLElement>("#catalogo-vazio");

    let categoriaAtiva = "todos";

    function aplicarFiltro() {
      const termo = normalizar((inputBusca?.value ?? "").trim());

      const combinam = cards.filter((card) => {
        const combinaCategoria =
          categoriaAtiva === "todos" ||
          card.dataset.categoria === categoriaAtiva;
        const combinaBusca =
          termo === "" || normalizar(card.dataset.nome ?? "").includes(termo);
        return combinaCategoria && combinaBusca;
      });

      const combinamSet = new Set(combinam);

      for (const card of cards) {
        card.classList.toggle("hidden", !combinamSet.has(card));
      }

      const temResultado = combinam.length > 0;
      grid?.classList.toggle("hidden", !temResultado);
      vazio?.classList.toggle("hidden", temResultado);
    }

    inputBusca?.addEventListener("input", aplicarFiltro);

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        categoriaAtiva = chip.dataset.categoria ?? "todos";
        for (const outro of chips) {
          const ativo = outro === chip;
          outro.dataset.active = String(ativo);
          outro.setAttribute("aria-pressed", String(ativo));
        }
        aplicarFiltro();
      });
    }

    aplicarFiltro();
  }
</script>
