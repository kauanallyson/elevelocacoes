---
import type { Equipamento } from "../../data/equipamentos";
import { CATEGORIAS } from "../../data/equipamentos";
import CardEquipamento from "./CardEquipamento.astro";

type Props = {
  equipamentos: Equipamento[];
  id?: string;
  class?: string;
};

const { equipamentos, id, class: className } = Astro.props;

const categoriaLabelPorId = new Map(
  CATEGORIAS.map((c) => [c.id, c.label] as const),
);
---

<div id={id} class={className ?? "grid grid-cols-2 gap-5 sm:grid-cols-4"}>
  {
    equipamentos.map((equipamento) => (
      <CardEquipamento
        equipamento={equipamento}
        categoriaLabel={
          categoriaLabelPorId.get(equipamento.categoria) ??
          equipamento.categoria
        }
      />
    ))
  }
</div>
