<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-graphite-700 bg-graphite-900 px-4 py-4 sm:px-6"
>
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-3 sm:flex-row sm:justify-between"
  >
    <p class="text-sm text-graphite-100">
      Usamos cookies para entender como você usa o site e melhorar sua
      experiência. Você pode aceitar ou recusar o uso desses cookies.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        id="cookie-decline"
        type="button"
        class="rounded-md border border-graphite-700 px-4 py-2 text-sm text-graphite-100 transition-colors hover:border-accent hover:text-accent"
      >
        Recusar
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-graphite-900 transition-colors hover:bg-accent-dark"
      >
        Aceitar
      </button>
    </div>
  </div>
</div>

<script>
  import {
    CONSENT_CHANGED_EVENT,
    getConsent,
    setConsent,
  } from "../lib/consent";

  const banner = document.getElementById("cookie-consent");
  const aceitar = document.getElementById("cookie-accept");
  const recusar = document.getElementById("cookie-decline");

  function atualizarEspacamento() {
    const altura =
      banner && !banner.classList.contains("hidden") ? banner.offsetHeight : 0;

    document.body.style.paddingBottom = altura ? `${altura}px` : "";
    document.documentElement.style.setProperty(
      "--cookie-offset",
      `${altura}px`,
    );
  }

  function atualizarBanner() {
    banner?.classList.toggle("hidden", getConsent() !== null);
    atualizarEspacamento();
  }

  aceitar?.addEventListener("click", () => setConsent("granted"));
  recusar?.addEventListener("click", () => setConsent("denied"));

  window.addEventListener(CONSENT_CHANGED_EVENT, atualizarBanner);
  window.addEventListener("resize", atualizarEspacamento);

  atualizarBanner();
</script>
