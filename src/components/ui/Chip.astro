---
type Props = {
  categoria: string;
  active?: boolean;
};

const { categoria, active = false } = Astro.props;
---

<button
  type="button"
  class="chip-categoria rounded-sm border border-graphite-300 px-3.5 py-1.5 text-sm font-medium text-graphite-900 transition-colors data-[active=true]:border-accent data-[active=true]:bg-accent-tint data-[active=true]:text-accent-dark cursor-pointer"
  data-categoria={categoria}
  data-active={String(active)}
  aria-pressed={active}
>
  <slot />
</button>
