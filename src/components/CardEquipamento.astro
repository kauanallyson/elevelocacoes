---
import { formatBRL } from "../lib/formato";
import { linkWhatsApp, mensagemProduto } from "../lib/whatsapp";
import type { Equipamento } from "../data/equipamentos";
import { Image } from "astro:assets";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/produtos/*.{jpeg,jpg,png,gif,webp}",
);

const imagensPorSlug = Object.fromEntries(
  Object.entries(images).map(([caminho, carregarImagem]) => [
    caminho.replace(/^.*\//, "").replace(/\.[^.]+$/, ""),
    carregarImagem,
  ]),
);

type Props = {
  equipamento: Equipamento;
  categoriaLabel: string;
  temFoto: boolean;
};

const { equipamento, categoriaLabel, temFoto } = Astro.props;
const { slug, nome, tipoPreco, precos, descricao } = equipamento;
---

<article
  class="flex flex-col overflow-hidden rounded-md border border-graphite-100 bg-white transition-shadow hover:shadow-lg hover:shadow-graphite-900/5"
  data-card
  data-nome={nome}
  data-categoria={equipamento.categoria}
  data-pixel="produto"
  data-produto-nome={nome}
>
  <div class="relative aspect-4/3 w-full overflow-hidden bg-graphite-900">
    {
      temFoto ? (
        <Image
          src={imagensPorSlug[slug]()}
          alt={nome}
          loading="eager"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-4 text-center">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-8 w-8 fill-none stroke-accent"
            stroke-width={1.5}
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.1-3.1a5 5 0 0 1-6.7 6.7l-6.9 6.9a2 2 0 0 1-2.8-2.8l6.9-6.9a5 5 0 0 1 6.7-6.7l-3.1 3.1Z"
            />
          </svg>
          <p class="font-display text-sm leading-tight text-white">{nome}</p>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <div>
      <p
        class="font-mono text-[11px] uppercase tracking-wide text-graphite-700"
      >
        {categoriaLabel}
      </p>
      <h3 class="mt-1 font-display text-lg leading-tight text-graphite-900">
        {nome}
      </h3>
      {descricao && <p class="mt-1 text-sm text-graphite-700">{descricao}</p>}
    </div>

    <div class="mt-auto border-t border-graphite-100 pt-3">
      {
        tipoPreco === "periodo" ? (
          <>
            <p class="font-mono text-2xl font-semibold text-graphite-900">
              {formatBRL(precos.dia)}
              <span class="ml-1 text-sm font-normal text-graphite-700">
                /dia
              </span>
            </p>
            <dl class="mt-2 space-y-1 text-sm text-graphite-700">
              <div class="flex justify-between">
                <dt>Semana</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.semana)}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Quinzena</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.quinzena)}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Mês</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.mes)}
                </dd>
              </div>
            </dl>
          </>
        ) : (
          <>
            <p class="font-mono text-2xl font-semibold text-graphite-900">
              {formatBRL(precos.dia)}
              <span class="ml-1 text-sm font-normal text-graphite-700">
                peça/dia
              </span>
            </p>
            <dl class="mt-2 space-y-1 text-sm text-graphite-700">
              <div class="flex justify-between">
                <dt>Dia</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.dia)}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Semana</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.semana)}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Quinzena</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.quinzena)}
                </dd>
              </div>
              <div class="flex justify-between">
                <dt>Mês</dt>
                <dd class="font-mono text-graphite-900">
                  {formatBRL(precos.mes)}
                </dd>
              </div>
            </dl>
          </>
        )
      }
    </div>

    <a
      href={linkWhatsApp(mensagemProduto(nome))}
      target="_blank"
      rel="noopener noreferrer"
      data-pixel="whatsapp"
      class="mt-1 inline-flex items-center justify-center rounded-sm bg-accent text-center px-4 py-2.5 text-sm font-semibold text-graphite-900 transition-colors hover:bg-accent-dark"
    >
      Solicite um orçamento
    </a>
  </div>
</article>
