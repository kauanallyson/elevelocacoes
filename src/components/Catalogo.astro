---
import fs from "node:fs";
import path from "node:path";
import { CATEGORIAS, EQUIPAMENTOS } from "../data/equipamentos";
import CatalogoFiltro from "./react/CatalogoFiltro";

const equipamentosComFoto = EQUIPAMENTOS.map((equipamento) => ({
  ...equipamento,
  temFoto: fs.existsSync(
    path.resolve("public/produtos", `${equipamento.slug}.jpg`),
  ),
}));
---

<section id="catalogo" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="font-mono text-xs font-medium uppercase tracking-[0.2em] text-accent-dark">
        Catálogo
      </p>
      <h2 class="mt-3 font-display text-3xl leading-tight text-graphite-900 sm:text-4xl">
        40 equipamentos, prontos para sua obra
      </h2>
      <p class="mt-3 text-graphite-700">
        Busque pelo nome ou filtre por categoria. O preço já vem no formato
        certo para cada equipamento — total do período ou por peça/dia.
      </p>
    </div>

    <CatalogoFiltro
      client:load
      equipamentos={equipamentosComFoto}
      categorias={CATEGORIAS}
    />
  </div>
</section>
