---
const anoAtual = new Date().getFullYear();
---

<footer class="bg-graphite-900">
  <div
    class="mx-auto grid max-w-6xl place-items-center gap-4 px-4 py-6 text-center sm:px-6 sm:py-10"
  >
    <div class="grid place-items-center gap-3">
      <p class="text-sm text-graphite-300">
        Locação de equipamentos para construção civil em Sobral-CE.
      </p>
      <p class="text-xs text-graphite-300/70">
        Preços podem sofrer reajuste e devem ser confirmados no atendimento.
      </p>
      <p class="mt-1 text-sm text-graphite-300">© {anoAtual} Eleve Locações</p>
      <button
        id="cookie-preferences"
        type="button"
        class="text-xs text-graphite-300/70 underline decoration-graphite-700 underline-offset-4 transition-colors hover:text-accent"
      >
        Preferências de cookies
      </button>
    </div>

    <div class="h-px w-full bg-graphite-700"></div>

    <p class="flex items-center gap-1 text-xs text-graphite-300">
      Feito por
      <a
        href="https://kauanallyson.com.br"
        target="_blank"
        rel="noopener noreferrer"
        class="text-graphite-300 underline decoration-graphite-700 underline-offset-4 transition-colors hover:text-accent"
      >
        kauanallyson
      </a>
    </p>
  </div>
</footer>

<script>
  import { clearConsent } from "../lib/consent";

  document
    .getElementById("cookie-preferences")
    ?.addEventListener("click", clearConsent);
</script>
