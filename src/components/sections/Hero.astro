---
import { Image } from "astro:assets";
import logoHorizontal from "../../assets/logo3x1-no-bg.png";
import { linkWhatsApp, MENSAGEM_GERAL } from "../../lib/whatsapp";
import Button from "../ui/Button.astro";
---

<section class="relative overflow-hidden bg-graphite-900 py-12 sm:py-16">
  <div
    class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[3fr_2fr] lg:items-stretch"
  >
    <div>
      <p
        class="font-mono text-xs font-medium uppercase tracking-[0.25em] text-accent"
      >
        Sobral, Tianguá, Preá, Camocim e região
      </p>
      <h1
        class="mt-5 font-display text-[2rem] leading-none text-white sm:text-6xl"
      >
        Aluguel de Escoras, Andaimes, Betoneiras{" "}
        <span class="text-accent">e Muito Mais.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed sm:text-[18px]">
        Maior frota de escoras e andaimes da região, equipamentos certificados e
        atendimento com agilidade.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/catalogo" size="lg">Ver catálogo</Button>
        <Button
          href={linkWhatsApp(MENSAGEM_GERAL)}
          target="_blank"
          rel="noopener noreferrer"
          data-pixel="whatsapp"
          variant="secondary-dark"
          size="lg"
        >
          Entre em contato
        </Button>
      </div>
    </div>

    <div
      class="flex flex-col justify-between border-t border-graphite-700 pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0"
    >
      <div
        class="hidden flex-1 items-center justify-center py-6 sm:flex lg:py-8"
      >
        <Image
          src={logoHorizontal}
          alt="Eleve Locações de Equipamentos"
          class="w-full max-w-md rounded-sm hidden lg:block lg:max-w-lg"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
