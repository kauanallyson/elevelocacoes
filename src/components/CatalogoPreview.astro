---
import fs from "node:fs";
import path from "node:path";
import { CATEGORIAS, EQUIPAMENTOS } from "../data/equipamentos";
import CardEquipamento from "./CardEquipamento.astro";

const ITENS_PREVIA = 4;

const equipamentosComFoto = EQUIPAMENTOS.map((equipamento) => ({
  ...equipamento,
  temFoto: fs.existsSync(
    path.resolve("src/assets/produtos", `${equipamento.slug}.webp`),
  ),
}));

const equipamentosExibidos = equipamentosComFoto.slice(0, ITENS_PREVIA);

const categoriaLabelPorId = new Map(
  CATEGORIAS.map((c) => [c.id, c.label] as const),
);
---

<section id="catalogo" class="bg-white py-8 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="font-mono font-medium uppercase text-accent-dark text-4xl">
        Catálogo
      </p>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-4">
      {
        equipamentosExibidos.map((equipamento) => (
          <CardEquipamento
            equipamento={equipamento}
            categoriaLabel={
              categoriaLabelPorId.get(equipamento.categoria) ??
              equipamento.categoria
            }
            temFoto={equipamento.temFoto}
          />
        ))
      }
    </div>

    <div class="mt-8 flex justify-center">
      <a
        href="/catalogo"
        class="inline-flex items-center justify-center rounded-sm border border-graphite-300 px-5 py-2.5 text-sm font-semibold text-graphite-900 transition-colors hover:border-accent hover:text-accent-dark"
      >
        Ver catálogo completo
      </a>
    </div>
  </div>
</section>
