---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import EquipamentoList from "../components/catalogo/EquipamentoList.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/sections/Footer.astro";
import WhatsAppButton from "../components/sections/WhatsAppButton.astro";
import Button from "../components/ui/Button.astro";
import { EQUIPAMENTOS } from "../data/equipamentos";

const PREVIA = ["escora", "painel-metalico", "barra-de-ancoragem", "betoneira"];

const previaEquipamentos = PREVIA.map(
  (slug) => EQUIPAMENTOS.find((equipamento) => equipamento.slug === slug)!,
);
---

<Layout>
  <Header />
  <main>
    <Hero />
    <section id="catalogo" class="bg-white py-8 sm:py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="font-mono font-medium uppercase text-accent-dark text-4xl">
            Catálogo
          </p>
        </div>

        <EquipamentoList
          class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-4"
          equipamentos={previaEquipamentos}
        />

        <div class="mt-8 flex justify-center">
          <Button href="/catalogo" variant="secondary">
            Ver catálogo completo
          </Button>
        </div>
      </div>
    </section>
    <Contact />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
